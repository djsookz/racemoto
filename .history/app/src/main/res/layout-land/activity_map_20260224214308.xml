<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="60dp">

        <RelativeLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#121212"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:elevation="8dp"
            android:fitsSystemWindows="true">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:drawableStart="@drawable/ic_chevron_left"
                android:textSize="22sp"
                android:padding="8dp"
                android:contentDescription="Назад" />

            <ImageView
                android:id="@+id/btnPreviousLap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/btnBack"
                android:layout_marginStart="6dp"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_left"
                android:tint="#FFFFFF"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvSessionTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:layout_marginStart="56dp"
                android:layout_marginEnd="56dp"
                android:gravity="center"
                android:text="Име на сесия"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"
                android:ellipsize="end"
                android:singleLine="true" />

            <ImageView
                android:id="@+id/btnNextLap"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="8dp"
                android:padding="8dp"
                android:src="@drawable/ic_chevron_right"
                android:tint="#FFFFFF"
                android:visibility="gone" />
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/infoScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="2dp">

                    <FrameLayout
                        android:id="@+id/mapContainer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <org.osmdroid.views.MapView
                            android:id="@+id/mapRoute"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </FrameLayout>

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#3A3D40"
                    android:paddingVertical="5dp"
                    android:paddingHorizontal="16dp"
                    android:layout_marginBottom="2dp">

                    <TextView
                        android:id="@+id/tvReaderSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#FC7805"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center" />

                    <TextView
                        android:id="@+id/tvReaderAngle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#05FCE3"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:visibility="gone" />

                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#3A3D40">

                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/chart"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/chart_height"
                            android:minHeight="180dp" />

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp">

                    <com.google.android.material.tabs.TabLayout
                        android:id="@+id/tabs"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:background="#3A3D40"
                        app:tabIndicatorColor="#FF6020"
                        app:tabSelectedTextColor="#FFFFFF"
                        app:tabTextColor="@color/white"
                        app:tabMode="fixed"
                        app:tabGravity="fill" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/card_margin">

                    <LinearLayout
                        android:id="@+id/infoPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#3A3D40"
                        android:paddingHorizontal="5dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingTop="@dimen/header_padding"
                            android:paddingBottom="@dimen/header_padding">

                            <View
                                android:layout_width="4dp"
                                android:layout_height="24dp"
                                android:background="@drawable/info_accent" />

                            <TextView
                                android:id="@+id/tvInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:text="@string/map_information"
                                android:textSize="@dimen/header_text_size"
                                android:textStyle="bold"
                                android:textColor="#FFF"
                                android:fontFamily="sans-serif-medium"
                                android:paddingStart="@dimen/text_padding"
                                android:paddingEnd="@dimen/text_padding" />

                            <TextView
                                android:id="@+id/sessionDateTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="@dimen/small_text_size"
                                android:textColor="#9E9E9E"
                                android:fontFamily="sans-serif"
                                android:layout_marginEnd="@dimen/text_padding" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="5dp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="5dp"
                                android:layout_marginBottom="4dp"
                                app:cardBackgroundColor="#2A2D30"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="12dp">

                                    <TextView
                                        android:id="@+id/tvMaxSpeedInfo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/max_speed"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="end"
                                        android:paddingEnd="12dp" />

                                    <View
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:background="@drawable/stat_dot_speed"
                                        android:layout_gravity="center_vertical" />

                                    <TextView
                                        android:id="@+id/tvAvgSpeedInfo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/avg_speed"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="start"
                                        android:paddingStart="12dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="5dp"
                                android:layout_marginBottom="4dp"
                                app:cardBackgroundColor="#2A2D30"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="12dp">

                                    <TextView
                                        android:id="@+id/tvTotalTime"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/map_duration"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="end"
                                        android:paddingEnd="12dp" />

                                    <View
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:background="@drawable/stat_dot_time"
                                        android:layout_gravity="center_vertical" />

                                    <TextView
                                        android:id="@+id/tvDistanceCar"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/map_distance"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="start"
                                        android:paddingStart="12dp"
                                        android:visibility="gone" />

                                    <TextView
                                        android:id="@+id/tvDistanceMoto"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/map_distance"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="start"
                                        android:paddingStart="12dp"
                                        android:visibility="gone" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/maxLeftLayout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="5dp"
                                app:cardBackgroundColor="#2A2D30"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="0dp"
                                android:visibility="gone">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:padding="12dp">

                                    <TextView
                                        android:id="@+id/tvMaxLeftInfo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/max_left_angle"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="end"
                                        android:paddingEnd="12dp" />

                                    <View
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:background="@drawable/stat_dot_left"
                                        android:layout_gravity="center_vertical" />

                                    <TextView
                                        android:id="@+id/tvMaxRightInfo"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/max_right_angle"
                                        android:textSize="11sp"
                                        android:textColor="#FFF"
                                        android:fontFamily="sans-serif-medium"
                                        android:gravity="start"
                                        android:paddingStart="12dp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:id="@+id/maxRightLayout"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="0dp" />

                            <LinearLayout
                                android:id="@+id/distanceCarContainer"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="0dp" />

                            <LinearLayout
                                android:id="@+id/distanceMotoContainer"
                                android:visibility="gone"
                                android:layout_width="0dp"
                                android:layout_height="0dp" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

    <!-- Fixed Bottom Button -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_gravity="bottom"
        android:backgroundTint="#1976D2"
        android:text="@string/session_new_button"
        android:textColor="@android:color/white"
        android:textSize="@dimen/button_text_size"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium" />

</FrameLayout>

