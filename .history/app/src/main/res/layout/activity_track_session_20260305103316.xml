<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvCurrentLap"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_track_lap_badge"
        android:paddingStart="18dp"
        android:paddingTop="6dp"
        android:paddingEnd="18dp"
        android:paddingBottom="6dp"
        android:text="LAP 0"
        android:textAllCaps="true"
        android:textColor="#0F1115"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Content area between top and bottom bar (fixed gauge, scrollable laps only) -->
    <LinearLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tvCurrentLap"
        android:layout_above="@+id/bottomBar"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Central Speed Gauge Card (fixed) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1C2128"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="2dp">

                <!-- Speed Gauge -->
                <com.example.clinometer.SpeedGaugeView
                    android:id="@+id/speedGauge"
                    android:layout_width="match_parent"
                    android:layout_height="430dp"
                    android:layout_centerInParent="true" />

                <!-- Lap Time -->
                <TextView
                    android:id="@+id/tvLapTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignBottom="@id/speedGauge"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="75dp"
                    android:text="@string/track_time_format"
                    android:textColor="#FF6020"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        <!-- Laps Card (fills remaining space; internal scroll only for laps list) -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track_laps_header"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <!-- Only the list area scrolls -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fillViewport="true"
                    android:clipToPadding="false">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Laps Container -->
                        <LinearLayout
                            android:id="@+id/llLapsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- No Laps Message -->
                        <TextView
                            android:id="@+id/tvNoLaps"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/track_no_laps"
                            android:textColor="#CCCCCC"
                            android:textSize="14sp"
                            android:gravity="center"
                            android:padding="16dp"
                            android:visibility="visible" />

                    </LinearLayout>
                </ScrollView>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- Bottom Control Buttons (fixed) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/background_primary"
        android:elevation="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLap"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/track_button_lap"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF9800"
            app:cornerRadius="28dp"
            app:iconSize="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartStop"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/track_button_start"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="#FF6020"
            app:cornerRadius="28dp"
            app:iconSize="16dp" />

    </LinearLayout>

</RelativeLayout>