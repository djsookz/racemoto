<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer circle -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#444444" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Inner circles for G-force levels -->
    <item android:top="15dp" android:bottom="15dp" android:left="15dp" android:right="15dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#666666"
                android:dashWidth="4dp"
                android:dashGap="2dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <item android:top="30dp" android:bottom="30dp" android:left="30dp" android:right="30dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="#666666"
                android:dashWidth="4dp"
                android:dashGap="2dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    
    <!-- Crosshair lines -->
    <item>
        <shape android:shape="line">
            <stroke
                android:width="1dp"
                android:color="#666666" />
        </shape>
    </item>
    
</layer-list>
