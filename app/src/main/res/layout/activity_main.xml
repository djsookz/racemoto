<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    tools:context=".MainActivity"
    android:fitsSystemWindows="true">

    <!-- Top: Map Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Bottom: Dashboard -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#161B22"
        android:padding="5dp"
        android:paddingBottom="0dp">

        <!-- Main Content Area -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentArea"
            android:layout_width="360dp"
            android:layout_height="250dp"
            app:layout_constraintBottom_toTopOf="@+id/accelerationContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Speedometer Background -->
            <ImageView
                android:id="@+id/speedometerBackground"
                android:layout_width="236dp"
                android:layout_height="217dp"
                android:src="@drawable/speedometer_circle"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="270dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="270dp"
                app:tint="#15616d" />

            <!-- Gauge View -->

            <!-- Speed Display -->

            <com.example.clinometer.GaugeView
                android:id="@+id/gaugeView"
                android:layout_width="236dp"
                android:layout_height="250dp"
                android:padding="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="270dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0"
                app:layout_constraintWidth_max="270dp" />

            <TextView
                android:id="@+id/speedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-thin"
                android:shadowColor="#0099CC"
                android:shadowRadius="10"
                android:text="0"
                android:textAlignment="center"
                android:textColor="#00D4FF"
                android:textSize="48sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.35" />

            <!-- Angle Display -->

            <!-- Timer -->

            <TextView
                android:id="@+id/currentAngleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="0°"
                android:textAlignment="center"
                android:textColor="#58A6FF"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="@+id/speedometerBackground"
                app:layout_constraintEnd_toEndOf="@+id/speedometerBackground"
                app:layout_constraintStart_toStartOf="@+id/speedometerBackground"
                app:layout_constraintTop_toBottomOf="@+id/speedText"
                app:layout_constraintVertical_bias="0.05"
                app:layout_constraintHorizontal_bias="0.500"/>

            <Chronometer
                android:id="@+id/chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-35dp"
                android:textAlignment="center"
                android:textColor="#FFD700"
                android:textSize="18sp"
                app:layout_constraintEnd_toEndOf="@+id/speedometerBackground"
                app:layout_constraintStart_toStartOf="@+id/speedometerBackground"
                app:layout_constraintTop_toBottomOf="@+id/speedometerBackground" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Acceleration Metrics -->
        <LinearLayout
            android:id="@+id/accelerationContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/buttonContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/tvZeroTo100"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0-100: -"
                android:textColor="#00D4FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvZeroTo200"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="0-200: -"
                android:textColor="#00D4FF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvHundredTo200"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="100-200: -"
                android:textColor="#00D4FF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="@string/reset_button"
                android:textColor="#000"
                android:textSize="12sp"
                app:backgroundTint="#FFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button"/>

            <Button
                android:id="@+id/btnZero"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="@string/zero_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#4CAF50"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="@string/stop_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button"
                app:backgroundTint="#E53E3E"/>
        </LinearLayout>

        <!-- Hidden diagnostic elements -->
        <TextView
            android:id="@+id/maxSpeedText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/maxLeftText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>
        <TextView
            android:id="@+id/maxRightText"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>