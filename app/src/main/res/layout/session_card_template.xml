<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#2A2D30"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Session Header -->
        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTrackName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track Name"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTrackDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Track Details"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_resume"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF6020"
                android:textSize="12sp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                app:cornerRadius="8dp" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btnDeleteSession"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_delete"
                android:contentDescription="Изтрий сесия"
                android:padding="8dp"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/arrow"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:text="▼"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- Session Content -->
        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Outings will be added here dynamically -->
            <TextView
                android:id="@+id/tvNoOutings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Няма записани излизания"
                android:textColor="#9E9E9E"
                android:textSize="14sp"
                android:gravity="center"
                android:padding="32dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
