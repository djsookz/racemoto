<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E"
    android:fitsSystemWindows="true"
    android:id="@+id/settings_container">

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
    android:padding="16dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ====== ОБЩИ НАСТРОЙКИ (за цялата апликация) ====== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_general_header"
            android:textSize="16sp"
            android:textColor="#FF6B35"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="16dp"/>

        <!-- Always On Display -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Always On Display"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAlwaysOn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Battery Optimization -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBatteryOptimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Battery Optimization"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvBatteryOptimizationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Not optimized - tap to configure"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Drag Direction Calibration -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDragCalibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_drag_calibration"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvDragCalibrationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ Not calibrated - tap to calibrate"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Track Editor -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTrackEditor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track Editor"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Добави centerline точки за snapping на официални писти"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Map Provider -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMapProvider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Map Provider"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvMapProviderValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="OSMDroid (Default)"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test Mapbox -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTestMapbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Test Mapbox"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Open Mapbox test map"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Language Selection -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvLanguageValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_language_auto"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_units_header"
            android:textSize="13sp"
            android:textColor="#AAA"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"/>

        <!-- Speed Unit -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSpeedUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speed_unit"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvSpeedUnitValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_speed_kmh"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Distance Unit - СКРИТ, синхронизира се автоматично със скоростта -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDistanceUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_distance_unit"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvDistanceUnitValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_distance_km"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Temperature Unit -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTemperatureUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_temperature_unit"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <TextView
                    android:id="@+id/tvTemperatureUnitValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_temperature_celsius"
                    android:textSize="14sp"
                    android:textColor="#AAA"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- ====== DRAG РЕЖИМ ====== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_drag_header"
            android:textSize="16sp"
            android:textColor="#FF6B35"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <!-- Sound at 100 km/h -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_sound_100"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSound100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sound at 200 km/h -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_sound_200"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSound200"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sound at 402m -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_sound_402"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSound402"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voice Countdown -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_voice_countdown"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchVoiceCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ====== TRACK/ПИСТА РЕЖИМ ====== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_track_header"
            android:textSize="16sp"
            android:textColor="#FF6B35"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"/>

        <!-- Sound on Lap Completion -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_lap_complete_sound"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSoundLapComplete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sound on Personal Best -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardElevation="2dp"
            app:cardCornerRadius="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:background="#3A3D40">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/settings_personal_best_sound"
                    android:textSize="16sp"
                    android:textColor="#FFF"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchSoundPersonalBest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

<!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

    </androidx.constraintlayout.widget.ConstraintLayout>