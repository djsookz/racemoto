<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1C1C1E">

    <!-- Top bar with environment info -->
    <LinearLayout
        android:id="@+id/llEnvironmentBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="@color/card_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Temperature section with icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_thermometer"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag_temperature_placeholder"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>

        <!-- Altitude section with icon -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical|end">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_altitude"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/tvAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag_altitude_placeholder"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

    <!-- Start button - Позициониран над bottom navigation (което е в MainContainerActivity) -->
    <Button
        android:id="@+id/btnStartDragSession"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/start_drag_session"
        android:textSize="18sp"
        android:padding="16dp"
        android:backgroundTint="@color/accent_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Sessions list - Над бутона -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDragSessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/llEnvironmentBar"
        app:layout_constraintBottom_toTopOf="@id/btnStartDragSession"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- No data message - Над бутона -->
    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_drag_sessions"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llEnvironmentBar"
        app:layout_constraintBottom_toTopOf="@id/btnStartDragSession"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>