<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackFromDocumentEntry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_arrow_back"
            app:iconTint="@color/text_primary"
            app:strokeWidth="0dp" />

        <TextView
            android:id="@+id/tvDocumentEntryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/garage_document_entry_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCompleteDocumentReminder"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/garage_document_entry_complete_reminder_action"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text=""
            android:visibility="gone"
            app:icon="@drawable/ic_history_selection_check"
            app:iconTint="@color/text_secondary"
            app:rippleColor="@color/stroke_dark"
            app:strokeWidth="0dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="18dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/garage_document_entry_type_section"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/llDocumentEntryTypeRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/garage_document_entry_details_section"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/background_primary"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="1dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputDocumentEntryAmount"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/garage_document_entry_amount"
                    android:textColorHint="@color/text_tertiary"
                    app:boxBackgroundColor="@color/dark_surface"
                    app:boxStrokeColor="@color/primary_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:suffixText="€"
                    app:suffixTextColor="@color/text_tertiary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocumentEntryAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="numberDecimal"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputDocumentEntryOdometer"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/garage_document_entry_odometer"
                    android:textColorHint="@color/text_tertiary"
                    app:boxBackgroundColor="@color/dark_surface"
                    app:boxStrokeColor="@color/primary_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:suffixText="km"
                    app:suffixTextColor="@color/text_tertiary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocumentEntryOdometer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:inputType="number"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/garage_document_entry_date_section"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/background_primary"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="1dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputDocumentEntryDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/garage_document_entry_issue_date"
                    android:textColorHint="@color/text_tertiary"
                    app:boxBackgroundColor="@color/dark_surface"
                    app:boxStrokeColor="@color/primary_color"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="2dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_today"
                    app:endIconTint="@color/primary_color">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDocumentEntryDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:clickable="true"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_tertiary"
                        android:textSize="15sp" />
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/garage_document_entry_reminder_section"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/background_primary"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/garage_document_entry_reminder_switch"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDocumentEntryReminder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:thumbTint="@color/accent_color"
                        app:trackTint="@color/stroke_dark" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDocumentEntryReminderConfig"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:text="@string/garage_document_entry_reminder_helper"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/background_primary"
                        app:cardBackgroundColor="@color/dark_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/stroke_dark">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:letterSpacing="0.06"
                                android:text="@string/garage_maintenance_entry_reminder_date_subsection"
                                android:textColor="@color/text_tertiary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/llDocumentEntryReminderDateModeRows"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical" />

                            <LinearLayout
                                android:id="@+id/llDocumentEntryReminderDateDetails"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/inputDocumentEntryReminderDateInterval"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/garage_maintenance_entry_reminder_month_interval"
                                    android:textColorHint="@color/text_tertiary"
                                    app:boxBackgroundColor="@color/card_background"
                                    app:boxStrokeColor="@color/primary_color"
                                    app:boxStrokeWidth="1dp"
                                    app:boxStrokeWidthFocused="2dp"
                                    app:suffixText="@string/garage_maintenance_entry_reminder_months_suffix"
                                    app:suffixTextColor="@color/text_tertiary">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etDocumentEntryReminderDateInterval"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@null"
                                        android:inputType="number"
                                        android:textColor="@color/text_primary"
                                        android:textColorHint="@color/text_tertiary"
                                        android:textSize="15sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <com.google.android.material.textfield.TextInputLayout
                                    android:id="@+id/inputDocumentEntryReminderExactDate"
                                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:hint="@string/garage_maintenance_entry_reminder_exact_date"
                                    android:textColorHint="@color/text_tertiary"
                                    android:visibility="gone"
                                    app:boxBackgroundColor="@color/card_background"
                                    app:boxStrokeColor="@color/primary_color"
                                    app:boxStrokeWidth="1dp"
                                    app:boxStrokeWidthFocused="2dp"
                                    app:endIconMode="custom"
                                    app:endIconDrawable="@android:drawable/ic_menu_today"
                                    app:endIconTint="@color/primary_color">

                                    <com.google.android.material.textfield.TextInputEditText
                                        android:id="@+id/etDocumentEntryReminderExactDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@null"
                                        android:clickable="true"
                                        android:cursorVisible="false"
                                        android:focusable="false"
                                        android:inputType="none"
                                        android:textColor="@color/text_primary"
                                        android:textColorHint="@color/text_tertiary"
                                        android:textSize="15sp" />
                                </com.google.android.material.textfield.TextInputLayout>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="12dp"
                                    android:layout_marginBottom="8dp"
                                    android:text="@string/garage_document_entry_reminder_notify_before"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/llDocumentEntryReminderDateLeadRows"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />

                            </LinearLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvDocumentEntryReminderSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/text_tertiary"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/garage_document_entry_receipt_section"
            android:textAllCaps="true"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_marginTop="10dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/background_primary"
            app:cardBackgroundColor="@color/card_background"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/stroke_dark">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDocumentEntryReceiptImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/garage_document_entry_receipt_add"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_add"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconTint="@color/accent_color"
                    app:strokeColor="@color/stroke_dark" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDocumentEntryReceiptPreview"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/dark_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stroke_dark"
                    app:strokeWidth="1dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/ivDocumentEntryReceiptPreview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/garage_document_entry_receipt_preview"
                            android:scaleType="centerCrop" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_margin="12dp"
                            android:background="@color/background_transparent_80"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:text="@string/garage_document_entry_receipt_preview"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelDocumentEntry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/garage_fuel_entry_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            app:cornerRadius="26dp"
            app:strokeColor="#22FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDocumentEntry"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/garage_fuel_entry_save"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:backgroundTint="@color/accent_color"
            app:cornerRadius="26dp" />

    </LinearLayout>

</LinearLayout>