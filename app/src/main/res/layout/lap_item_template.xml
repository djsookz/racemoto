<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="6dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_stat_item"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/tvLapNumber"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="1"
        android:textAllCaps="true"
        android:textColor="#8CA1BC"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLapTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="1:23.456"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLapMaxV"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="000"
        android:textColor="#E2ECF7"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:fontFamily="monospace"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvLapDelta"
        android:layout_width="72dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:text="+0.000"
        android:textColor="#F44336"
        android:textSize="14sp"
        android:includeFontPadding="false"
        android:fontFamily="monospace"
        android:textStyle="bold" />

</LinearLayout>
