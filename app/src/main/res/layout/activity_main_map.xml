<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Container for search input and profile info side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Destination search pill (collapsed state) -->
        <LinearLayout
            android:id="@+id/destinationSearchContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#666666" />

            <TextView
                android:id="@+id/tvDestinationPlaceholder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/destination_placeholder"
                android:textColor="#999999"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Right side: Profile model name and image (outside search input) -->
        <LinearLayout
            android:id="@+id/llActiveProfileHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="5dp"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvHeaderModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                android:text=""
                android:minWidth="30dp"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileImage"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#4DFFFFFF"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/ivHeaderProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_car"
                    android:visibility="visible"
                    android:contentDescription="Profile image" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Route Info Container (shown when routes are calculated) -->
    <LinearLayout
        android:id="@+id/routeInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        android:background="@drawable/bg_route_info_container"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDestinationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дестинация"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvRouteDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.0 km"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRouteDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0м"
                android:textColor="#FF6020"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search button (visible only after destination selection, above motorway options) -->
    <ImageButton
        android:id="@+id/btnSearchRoute"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="155dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_search"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Търси нова дестинация"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
        android:visibility="gone"
         />

    <!-- Motorway options button (visible only after destination selection) -->
    <ImageButton
        android:id="@+id/btnMotorwayOptions"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_road"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Route options"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
       android:visibility="gone"
         />

    <!-- Route preview controls Overview + Recenter -->
    <ImageButton
        android:id="@+id/btnPreviewRecenter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_navigation"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Recenter"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
        android:visibility="gone"
         />

    <ImageButton
        android:id="@+id/btnPreviewOverview"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="155dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_route"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Overview"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
        android:visibility="gone"
         />

    <!-- Motorway options container -->
    <LinearLayout
        android:id="@+id/motorwayOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:orientation="horizontal"
        android:background="#1C1C1E"
        android:padding="16dp"
        android:elevation="12dp"
        android:gravity="center"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnWithMotorways"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_motorway"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="С магистрали"
            app:tint="#FFFFFF"
            android:stateListAnimator="@null" />

        <ImageButton
            android:id="@+id/btnWithoutMotorways"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_road"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Без магистрали"
            app:tint="#FFFFFF"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- Bottom Container for Route Preview (Cancel + Navigate buttons, like initial page) -->
    <LinearLayout
        android:id="@+id/routePreviewBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Два бутона (Cancel отляво, Navigate отдясно) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- Cancel бутон (ляво, тъмен) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRoute"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="#2C2C2E"
                app:cornerRadius="30dp" />

            <!-- Navigate бутон (дясно, оранжев) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateRoute"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Navigate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Основна карта - заема целия екран -->
    <!-- MapView will be added programmatically based on selected provider -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/navSessionContainer">
        
        <!-- OSMDroid MapView (default, will be removed if Mapbox is selected) -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </org.osmdroid.views.MapView>
    </FrameLayout>

    <!-- Maneuver View (navigation) -->
    <FrameLayout
        android:id="@+id/maneuverContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="@dimen/hud_maneuver_margin_start_portrait"
        android:layout_marginEnd="@dimen/hud_maneuver_margin_end_portrait"
        android:layout_marginTop="@dimen/hud_maneuver_margin_top_portrait"
        android:maxWidth="@dimen/hud_maneuver_max_width_portrait"
        android:background="@drawable/bg_map_controls_pill"
        android:clipToOutline="true"
        android:outlineProvider="background"
        android:visibility="gone">

        <com.mapbox.navigation.ui.components.maneuver.view.MapboxManeuverView
            android:id="@+id/maneuverView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingEnd="0dp" />
    </FrameLayout>

    <!-- Bottom HUD (speed + trip progress) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomHudRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/navSessionContainer"
        android:layout_marginStart="@dimen/hud_bottom_row_margin_start_portrait"
        android:layout_marginBottom="8dp"
        android:paddingEnd="@dimen/hud_bottom_row_padding_end_portrait"
        android:visibility="gone">

        <!-- Speed overlay (left) -->
        <LinearLayout
            android:id="@+id/speedOverlayContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/speedTextCar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/hud_speed_min_width_portrait"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"
                android:background="@drawable/bg_speed_circle"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Trip progress pills (right) -->
        <LinearLayout
            android:id="@+id/tripProgressContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_map_controls_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/hud_trip_padding_h_portrait"
            android:paddingVertical="@dimen/hud_trip_padding_v_portrait"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/hud_trip_value_min_width_portrait">

                <TextView
                    android:id="@+id/tvTripEta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/hud_trip_value_min_width_portrait"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/hud_trip_value_text_size_portrait"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTripEtaLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="ETA"
                    android:textColor="#E0E0E0"
                    android:textSize="@dimen/hud_trip_label_text_size_portrait" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="@dimen/hud_trip_separator_margin_h_portrait"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/hud_trip_value_min_width_portrait">

                <TextView
                    android:id="@+id/tvTripRemainingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/hud_trip_value_min_width_portrait"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:text="--:--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/hud_trip_value_text_size_portrait"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTripRemainingTimeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="time"
                    android:textColor="#E0E0E0"
                    android:textSize="@dimen/hud_trip_label_text_size_portrait" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="@dimen/hud_trip_separator_margin_h_portrait"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:minWidth="@dimen/hud_trip_value_min_width_portrait">

                <TextView
                    android:id="@+id/tvTripRemainingDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/hud_trip_value_min_width_portrait"
                    android:gravity="center"
                    android:singleLine="true"
                    android:ellipsize="none"
                    android:text="--"
                    android:textColor="#FFFFFFFF"
                    android:textSize="@dimen/hud_trip_value_text_size_portrait"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTripRemainingDistanceLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="km"
                    android:textColor="#E0E0E0"
                    android:textSize="@dimen/hud_trip_label_text_size_portrait" />
            </LinearLayout>
        </LinearLayout>

        <!-- Motorcycle portrait: lean angle + gauge above pills -->
        <LinearLayout
            android:id="@+id/angleContainerMoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="5dp"
            app:layout_constraintEnd_toEndOf="@+id/tripProgressContainer"
            app:layout_constraintBottom_toTopOf="@+id/tripProgressContainer">

            <TextView
                android:id="@+id/angleTextMoto"
                android:layout_width="75dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textAlignment="center"
                android:background="@drawable/bg_angle_pill"
                android:text="0°"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <com.example.clinometer.LinearGaugeView
                android:id="@+id/linearGaugeView"
                android:layout_width="@dimen/hud_angle_gauge_width_portrait"
                android:layout_height="16dp"
                android:layout_marginTop="5dp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Temperature Pill (expandable HORIZONTAL, дясно, под FAB бутона) -->
    <LinearLayout
        android:id="@+id/llTemperature"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_thermometer"
            app:tint="#fff"
             />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_temperature_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (hidden by default, extends LEFT horizontally) -->
        <TextView
            android:id="@+id/llWeatherExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨12km/h 💧65% 🌧️0%"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      COMPAT STUBS:
      These hidden views keep old resource ids around so we don't crash with NoSuchFieldError
      if an older dex (from Instant Run / Apply Changes) is still being executed on device.
    -->
    <FrameLayout
        android:id="@+id/navCompatStubContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navBottomContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNavSpeed"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavReset"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavZero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavEnd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/maneuverViewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivManeuverIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvManeuverDistance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvManeuverPrimary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Altitude Pill (expandable, ляво, на същата височина като температурата) -->
    <LinearLayout
        android:id="@+id/llAltitude"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_altitude"
             />

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_altitude_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="none" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvAltSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (pressure) -->
        <TextView
            android:id="@+id/llAltitudeExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 1013 hPa"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>



    <!-- Бутон за центриране на локацията (заменям FAB с ImageView за да има stroke) -->
    <FrameLayout
        android:id="@+id/fabMyLocationContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/fab_stroke"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/fabMyLocation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_my_location"
            app:tint="#FFFFFF"/>
    </FrameLayout>

    <!-- Map controls (top-right) -->
    <LinearLayout
        android:id="@+id/mapControlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="300dp"
        android:background="@drawable/bg_map_controls_pill"
        android:orientation="vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp"
        android:gravity="center_horizontal"
        >

        <ImageButton
            android:id="@+id/btnOrientationToggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_control_orientation"
            android:src="@drawable/ic_unlock"
            android:padding="6dp"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnCameraNorthMode"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/map_control_heading_mode"
            android:src="@drawable/ic_map_heading"
            android:padding="6dp"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnOverview"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Overview"
            android:src="@drawable/ic_route"
            android:padding="6dp"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <ImageButton
            android:id="@+id/btnRecenter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Recenter"
            android:src="@drawable/ic_navigation"
            android:padding="6dp"
            android:visibility="gone"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Navigation session controls (distance/time + buttons) -->
    <LinearLayout
        android:id="@+id/navSessionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:visibility="gone"
        >

        <!-- Car Mode Stats (distance + time) -->
        <LinearLayout
            android:id="@+id/carModeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/transparent"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/distanceTextCar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="km"
                    android:textColor="@color/primary_color"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginHorizontal="16dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <Chronometer
                    android:id="@+id/chronometerCar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="time"
                    android:textColor="@color/primary_color"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Button Container -->
        <LinearLayout
            android:id="@+id/buttonContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <Button
                android:id="@+id/btnReset"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:saveEnabled="false"
                android:text="@string/reset_button"
                android:textColor="#000"
                android:textSize="12sp"
                app:backgroundTint="#FFF"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnZero"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:saveEnabled="false"
                android:text="@string/zero_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#4CAF50"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:saveEnabled="false"
                android:text="@string/stop_button"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#E53935"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:stateListAnimator="@null"
                android:background="@drawable/rounded_button" />
        </LinearLayout>
    </LinearLayout>


    <!-- Контейнер за бутони + навигация (една тъмна кутия) -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:elevation="12dp">

        <!-- Два големи бутона -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- Бутон Сесии (ляво) -->

            <!-- Бутон Старт (дясно) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessions"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/map_sessions_button"
                android:textSize="16sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_sessions"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNavigationNoDestination"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/map_start_button"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

        <!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

    </LinearLayout>

    <!-- Inline Search Container (expanded state, like TestNavigationActivity) -->
    <!-- Moved to end of file to ensure it's on top of all other elements in RelativeLayout -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="24dp">

        <LinearLayout
            android:id="@+id/searchInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#666666" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Търси дестинация..."
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:background="@null"
                android:padding="0dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:background="@color/background_primary"
            android:elevation="20dp" />
    </LinearLayout>

</RelativeLayout>