<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Destination search field at the top -->
    <LinearLayout
        android:id="@+id/destinationSearchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="8dp"
        android:clickable="true"
        android:focusable="true">
        
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:tint="#666666" />
        
        <TextView
            android:id="@+id/tvDestinationPlaceholder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/destination_placeholder"
            android:textColor="#999999"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Основна карта - заема целия екран -->
    <!-- MapView will be added programmatically based on selected provider -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <!-- OSMDroid MapView (default, will be removed if Mapbox is selected) -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </org.osmdroid.views.MapView>
    </FrameLayout>

    <!-- Temperature Pill (expandable HORIZONTAL, дясно, под FAB бутона) -->
    <LinearLayout
        android:id="@+id/llTemperature"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_thermometer"
            app:tint="#fff"
             />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_temperature_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (hidden by default, extends LEFT horizontally) -->
        <TextView
            android:id="@+id/llWeatherExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨12km/h 💧65% 🌧️0%"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Altitude Pill (expandable, ляво, на същата височина като температурата) -->
    <LinearLayout
        android:id="@+id/llAltitude"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_altitude"
             />

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_altitude_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="none" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvAltSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (pressure) -->
        <TextView
            android:id="@+id/llAltitudeExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 1013 hPa"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>



    <!-- Бутон за центриране на локацията (заменям FAB с ImageView за да има stroke) -->
    <FrameLayout
        android:id="@+id/fabMyLocationContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/fab_stroke"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/fabMyLocation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_my_location"
            app:tint="#FFFFFF"/>
    </FrameLayout>


    <!-- Контейнер за бутони + навигация (една тъмна кутия) -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:elevation="12dp">

        <!-- Два големи бутона -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- Бутон Сесии (ляво) -->

            <!-- Бутон Старт (дясно) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessions"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/map_sessions_button"
                android:textSize="16sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_sessions"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNavigationNoDestination"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/map_start_button"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

        <!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

    </LinearLayout>

</RelativeLayout>