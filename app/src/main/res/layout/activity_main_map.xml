<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Container for search input and profile info side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:elevation="8dp">

        <!-- Destination search pill (collapsed state) -->
        <LinearLayout
            android:id="@+id/destinationSearchContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#666666" />

            <TextView
                android:id="@+id/tvDestinationPlaceholder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/destination_placeholder"
                android:textColor="#999999"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- Right side: Profile model name and image (outside search input) -->
        <LinearLayout
            android:id="@+id/llActiveProfileHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="5dp"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvHeaderModelName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                android:text=""
                android:minWidth="30dp"
                android:visibility="visible" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardProfileImage"
                android:layout_width="35dp"
                android:layout_height="35dp"
                app:cardCornerRadius="19dp"
                app:cardElevation="0dp"
                app:strokeWidth="1.5dp"
                app:strokeColor="#4DFFFFFF"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/ivHeaderProfileImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_car"
                    android:visibility="visible"
                    android:contentDescription="Profile image" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Route Info Container (shown when routes are calculated) -->
    <LinearLayout
        android:id="@+id/routeInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        android:background="#E6202123"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:elevation="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvDestinationName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Дестинация"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvRouteDistance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.0 km"
                android:textColor="#AAAAAA"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvRouteDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0м"
                android:textColor="#FF6020"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Search button (visible only after destination selection, above motorway options) -->
    <ImageButton
        android:id="@+id/btnSearchRoute"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_above="@+id/btnMotorwayOptions"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_search"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Търси нова дестинация"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
        android:visibility="gone"
         />

    <!-- Motorway options button (visible only after destination selection) -->
    <ImageButton
        android:id="@+id/btnMotorwayOptions"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_motorway_button"
        android:src="@drawable/ic_road"
        android:padding="16dp"
        android:scaleType="centerInside"
        android:contentDescription="Route options"
        app:tint="#FFFFFF"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        android:stateListAnimator="@null"
        android:elevation="16dp"
        android:visibility="gone" />

    <!-- Motorway options container -->
    <LinearLayout
        android:id="@+id/motorwayOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="96dp"
        android:orientation="horizontal"
        android:background="#1C1C1E"
        android:padding="16dp"
        android:elevation="12dp"
        android:gravity="center"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnWithMotorways"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_motorway"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="С магистрали"
            app:tint="#FFFFFF"
            android:stateListAnimator="@null" />

        <ImageButton
            android:id="@+id/btnWithoutMotorways"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_road"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:contentDescription="Без магистрали"
            app:tint="#FFFFFF"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- Bottom Container for Route Preview (Cancel + Navigate buttons, like initial page) -->
    <LinearLayout
        android:id="@+id/routePreviewBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:elevation="12dp"
        android:visibility="gone">

        <!-- Два бутона (Cancel отляво, Navigate отдясно) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- Cancel бутон (ляво, тъмен) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelRoute"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Cancel"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="#2C2C2E"
                app:cornerRadius="30dp" />

            <!-- Navigate бутон (дясно, оранжев) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateRoute"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Navigate"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Основна карта - заема целия екран -->
    <!-- MapView will be added programmatically based on selected provider -->
    <FrameLayout
        android:id="@+id/mapContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <!-- OSMDroid MapView (default, will be removed if Mapbox is selected) -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
        </org.osmdroid.views.MapView>
    </FrameLayout>


    <!-- Temperature Pill (expandable HORIZONTAL, дясно, под FAB бутона) -->
    <LinearLayout
        android:id="@+id/llTemperature"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivWeatherIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_thermometer"
            app:tint="#fff"
             />

        <TextView
            android:id="@+id/tvTemperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_temperature_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (hidden by default, extends LEFT horizontally) -->
        <TextView
            android:id="@+id/llWeatherExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨12km/h 💧65% 🌧️0%"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>

    <!--
      COMPAT STUBS:
      These hidden views keep old resource ids around so we don't crash with NoSuchFieldError
      if an older dex (from Instant Run / Apply Changes) is still being executed on device.
    -->
    <FrameLayout
        android:id="@+id/navCompatStubContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/navBottomContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvNavSpeed"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavReset"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavZero"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnNavEnd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <androidx.cardview.widget.CardView
            android:id="@+id/maneuverViewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/ivManeuverIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvManeuverDistance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvManeuverPrimary"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tripProgressContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTripEta"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTripRemainingTime"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvTripRemainingDistance"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/mapControlsContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnOverview"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnRecenter"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Altitude Pill (expandable, ляво, на същата височина като температурата) -->
    <LinearLayout
        android:id="@+id/llAltitude"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:minWidth="90dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="90dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_white_pill"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:elevation="16dp"
        android:visibility="visible"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_altitude"
             />

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/drag_altitude_placeholder"
            android:textColor="#fff"
            android:textSize="14sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="none" />

        <!-- Separator (when expanded) -->
        <TextView
            android:id="@+id/tvAltSeparator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" • "
            android:textColor="#fff"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Expanded info (pressure) -->
        <TextView
            android:id="@+id/llAltitudeExpanded"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 1013 hPa"
            android:textColor="#fff"
            android:textSize="11sp"
            android:singleLine="true"
            android:ellipsize="none"
            android:visibility="gone" />

    </LinearLayout>



    <!-- Бутон за центриране на локацията (заменям FAB с ImageView за да има stroke) -->
    <FrameLayout
        android:id="@+id/fabMyLocationContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="140dp"
        android:background="@drawable/fab_stroke"
        android:elevation="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless">

        <ImageView
            android:id="@+id/fabMyLocation"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_my_location"
            app:tint="#FFFFFF"/>
    </FrameLayout>


    <!-- Контейнер за бутони + навигация (една тъмна кутия) -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:background="@color/background_primary"
        android:elevation="12dp">

        <!-- Два големи бутона -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:gravity="center">

            <!-- Бутон Сесии (ляво) -->

            <!-- Бутон Старт (дясно) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSessions"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="none"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/map_sessions_button"
                android:textSize="16sp"
                android:textStyle="bold"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeStepGranularity="1sp"
                app:autoSizeTextType="uniform"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_sessions"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartNavigationNoDestination"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/map_start_button"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="none"
                android:maxLines="1"
                app:autoSizeTextType="uniform"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeMaxTextSize="16sp"
                app:autoSizeStepGranularity="1sp"
                app:backgroundTint="@color/primary_color"
                app:cornerRadius="30dp"
                app:icon="@drawable/ic_play"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

        </LinearLayout>

        <!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

    </LinearLayout>

    <!-- Inline Search Container (expanded state, like TestNavigationActivity) -->
    <!-- Moved to end of file to ensure it's on top of all other elements in RelativeLayout -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="52dp"
        android:orientation="vertical"
        android:visibility="gone"
        android:elevation="24dp">

        <LinearLayout
            android:id="@+id/searchInputContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_white_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:tint="#666666" />

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:hint="Търси дестинация..."
                android:textColor="#FFFFFF"
                android:textColorHint="#999999"
                android:textSize="16sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:background="@null"
                android:padding="0dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSearchResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:background="#1C1C1E"
            android:elevation="20dp" />
    </LinearLayout>

</RelativeLayout>