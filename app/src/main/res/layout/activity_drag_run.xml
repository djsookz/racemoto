<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1C1C1E"
    >

    <!-- Status bar -->
<LinearLayout
    android:id="@+id/llStatusBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/card_background"
    android:padding="16dp"
    android:elevation="4dp"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent">

    <TextView
        android:id="@+id/tvMeasureStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/drag_waiting_for_start"
        android:textSize="16sp"
        android:textColor="@color/text_primary" />

</LinearLayout>

    <!-- Big speed display -->
<LinearLayout
android:id="@+id/llSpeedDisplay"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:gravity="center"
android:padding="24dp"
app:layout_constraintTop_toBottomOf="@id/llStatusBar"
app:layout_constraintBottom_toTopOf="@id/llTimeCards"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<TextView
    android:id="@+id/tvBigSpeed"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="0"
    android:textSize="90sp"
    android:textStyle="bold"
    android:textColor="@color/text_primary" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/tvSpeedUnit"
    android:text="@string/drag_speed_unit"
    android:textSize="20sp"
    android:textColor="@color/text_secondary" />

    <!-- G display block: GaugeView like in main activity -->
    <LinearLayout
        android:id="@+id/g_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_horizontal">

        <!-- GGaugeView for G-force visualization -->
        <com.example.clinometer.GGaugeView
            android:id="@+id/gGaugeView"
            android:layout_width="174dp"
            android:layout_height="180dp"
            android:layout_marginBottom="8dp" />

        <!-- current G big (centered) -->
        <TextView
            android:id="@+id/tvGCurrentBig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/drag_g_current"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp"
            android:gravity="center"
            android:visibility="gone"/>

        <!-- peak + hint on one row under the big value -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal">

            <TextView
                android:id="@+id/tvGPeakSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag_g_peak"
                android:textColor="@color/accent_blue"
                android:textSize="13sp"
                android:layout_marginEnd="12dp"/>

        </LinearLayout>
    </LinearLayout>


</LinearLayout>



    <!-- Time cards grid -->
<LinearLayout
android:id="@+id/llTimeCards"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="vertical"
android:padding="16dp"
app:layout_constraintBottom_toTopOf="@id/llButtons"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<!-- First row -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 0-100 card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card0to100"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="4dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvLabel0to100"
                android:text="@string/drag_label_0to100"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCard0to100Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drag_value_placeholder"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 0-200 card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card0to200"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="4dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvLabel0to200"
                android:text="@string/drag_label_0to200"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCard0to200Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drag_value_placeholder"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

<!-- Second row -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="8dp">

    <androidx.cardview.widget.CardView
    android:id="@+id/card100to200"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="93dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvLabel100to200"
                android:text="@string/drag_label_100to200"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvCard100to200Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drag_value_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRestartHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/drag_tap_to_restart"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:visibility="gone" />

        </LinearLayout>
</androidx.cardview.widget.CardView>

    <!-- 0-402m card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card0to402"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_margin="4dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvLabel0to402"
                android:text="@string/drag_label_quarter"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvCard0to402Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/drag_value_placeholder"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvCard0to402Distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/drag_distance_m"
                android:textSize="14sp"
                android:textColor="@color/accent_blue"
                android:visibility="visible" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>

</LinearLayout>

    <!-- Buttons -->
<LinearLayout
android:id="@+id/llButtons"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:orientation="horizontal"
android:padding="16dp"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintEnd_toEndOf="parent">

<Button
    android:id="@+id/btnStartMeasure"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="@string/stop_session"
    android:backgroundTint="#1976D2"
    android:textSize="16sp"
    android:padding="12dp"
    />

</LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>