<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#282828"
    android:forceDarkAllowed="false"
    app:cardPreventCornerOverlap="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:forceDarkAllowed="false">

    <!-- Checkbox за режим на избор (скрит по подразбиране) -->
    <CheckBox
        android:id="@+id/checkboxSelect"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:visibility="gone"
        android:buttonTint="#FF7A18"
        android:scaleX="1.3"
        android:scaleY="1.3"
        android:elevation="8dp"
        android:forceDarkAllowed="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:forceDarkAllowed="false">

        <!-- МИНИ КАРТА ОТГОРЕ - заема цялата ширина -->
        <FrameLayout
            android:id="@+id/miniMapContainer"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:forceDarkAllowed="false">

            <org.osmdroid.views.MapView
                android:id="@+id/miniMapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <!-- Overlay за loading/no data -->
            <LinearLayout
                android:id="@+id/layoutMapPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F1F3F4"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                android:forceDarkAllowed="false">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🗺️"
                    android:textSize="24sp"
                    android:layout_marginBottom="4dp"
                    android:forceDarkAllowed="false"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Няма данни за маршрут"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>
        </FrameLayout>

        <!-- Долна част с информация -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:paddingRight="26dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:forceDarkAllowed="false">

            <!-- Горна част - ляво и дясно -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:layout_marginTop="8dp"
                android:forceDarkAllowed="false">

                <!-- Лява страна - име на сесията и профил -->
                <LinearLayout
                    android:id="@+id/layoutLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:forceDarkAllowed="false">

                    <!-- Име на сесията -->
                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="sans-serif-medium"/>

                    <!-- Профил снимка и име на превозното средство -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:forceDarkAllowed="false">

                        <!-- Кръгла снимка на профила -->
                        <ImageView
                            android:id="@+id/ivProfileImage"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_marginEnd="8dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/profile_icon_background"/>

                        <!-- Име на превозното средство -->
                        <TextView
                            android:id="@+id/tvVehicleName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:textColor="#D3D3D3"
                            android:fontFamily="sans-serif"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Дясна страна - дата, разстояние и време -->
                <LinearLayout
                    android:id="@+id/layoutRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentEnd="true"
                    android:gravity="end"
                    android:forceDarkAllowed="false">

                    <!-- Дата (Today/Yesterday) -->
                    <TextView
                        android:id="@+id/dateTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:textSize="14sp"
                        android:textColor="#FFFFFF"
                        android:fontFamily="sans-serif"
                        android:gravity="end"/>

                    <!-- Разстояние и време -->
                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:textSize="12sp"
                        android:textColor="#D3D3D3"
                        android:fontFamily="sans-serif"
                        android:gravity="end"/>

                    <TextView
                        android:id="@+id/tvNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="#D3D3D3"
                        android:fontFamily="sans-serif"
                        android:gravity="end"/>
                </LinearLayout>
            </RelativeLayout>

            <!-- Долна част - три бутона -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="2dp"
                android:forceDarkAllowed="false">

                <!-- Бутон за любими (сърце) -->
                <ImageButton
                    android:id="@+id/btnFavorite"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_favorite_border"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tab_favorites"
                    android:padding="12dp"
                    android:layout_marginEnd="25dp"
                    android:forceDarkAllowed="false"/>

                <!-- Бутон за редактиране -->
                <ImageButton
                    android:id="@+id/btnEdit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_edit"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Edit session"
                    android:padding="12dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="25dp"
                    android:forceDarkAllowed="false"/>

                <!-- Бутон за триене -->
                <ImageButton
                    android:id="@+id/btnDelete"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:src="@drawable/ic_delete"
                    app:tint="#FFFFFF"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/profile_delete_button"
                    android:padding="12dp"
                    android:layout_marginStart="10dp"
                    android:forceDarkAllowed="false"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
