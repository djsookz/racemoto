<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/reportAlertPanel"
    android:layout_width="70dp"
    android:layout_height="90dp"
    android:background="@drawable/bg_report_alert"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:elevation="8dp"
    android:clickable="true"
    android:focusable="true">
    
    <!-- Report Icon + Police beacons -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal">

        <TextView
            android:id="@+id/tvReportIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="32sp"
            tools:text="🚔" />

        <View
            android:id="@+id/viewPoliceBeaconLeft"
            android:layout_width="10dp"
            android:layout_height="6dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="23dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_police_beacon_red"
            android:visibility="gone"
            tools:visibility="visible" />

        <View
            android:id="@+id/viewPoliceBeaconRight"
            android:layout_width="10dp"
            android:layout_height="6dp"
            android:layout_gravity="top|end"
            android:layout_marginEnd="22dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_police_beacon_blue"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
    
    <!-- Distance Text -->
    <TextView
        android:id="@+id/tvReportDistance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        tools:text="500м" />
    
    <!-- Warning Icon (shown when very close <100m) -->
    <TextView
        android:id="@+id/tvWarningIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠️"
        android:textSize="16sp"
        android:layout_marginTop="2dp"
        android:visibility="gone"
        tools:visibility="visible" />
</LinearLayout>
