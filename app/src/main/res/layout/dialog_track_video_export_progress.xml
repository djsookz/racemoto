<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_track_metric_speed"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvTrackVideoExportTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/track_session_video_export_progress_title"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTrackVideoExportMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/track_session_video_export_progress_message"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <ProgressBar
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="18dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_color"
        android:progressBackgroundTint="#26FFFFFF" />

</LinearLayout>