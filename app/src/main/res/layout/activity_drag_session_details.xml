<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#1C1C1E">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/tvDetailSessionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drag Session 1"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvDetailSessionDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01.01.2024 14:30"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCompare"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_compare"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:contentDescription="@string/compare_attempts" />
    </LinearLayout>

    <!-- Environment info -->
    <LinearLayout
        android:id="@+id/llEnvironment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/llHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Temperature -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_thermometer"
                app:tint="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDetailTemperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22°C"
                android:textSize="15sp"
                android:textColor="@color/white" />

        </LinearLayout>

        <!-- Altitude -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_altitude"
                app:tint="@color/text_secondary"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tvDetailAltitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="450m"
                android:textSize="15sp"
                android:textColor="@color/white" />

        </LinearLayout>

    </LinearLayout>

    <!-- Best times summary -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvBestTimes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/llEnvironment"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="50dp"
            android:paddingVertical="6dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag_best_times_header"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="12dp" />

            <!-- 0-100 time -->
            <LinearLayout
                android:id="@+id/ll0to100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/tvLabelBest0to100"
                    android:text="@string/drag_best_0to100_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDetailBest0to100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.532s"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_green" />

            </LinearLayout>

            <!-- 0-200 time -->
            <LinearLayout
                android:id="@+id/ll0to200"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/tvLabelBest0to200"
                    android:text="@string/drag_best_0to200_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDetailBest0to200"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12.456s"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_blue" />

            </LinearLayout>

            <!-- 100-200 time -->
            <LinearLayout
                android:id="@+id/ll100to200"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/tvLabelBest100to200"
                    android:text="@string/drag_best_100to200_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDetailBest100to200"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7.924s"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_orange" />

            </LinearLayout>

            <!-- 0-402m time -->
            <LinearLayout
                android:id="@+id/ll0to402"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:id="@+id/tvLabelBest0to402"
                    android:text="@string/drag_best_quarter_label"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvDetailBest0to402"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11.234s"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/accent_red" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Attempts list header -->
    <TextView
        android:id="@+id/tvAttemptsHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/drag_all_attempts"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cvBestTimes"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- No attempts message -->
    <TextView
        android:id="@+id/tvNoAttempts"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_attempts_recorded"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvAttemptsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Attempts list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDetailAttempts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:padding="8dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/tvAttemptsHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>