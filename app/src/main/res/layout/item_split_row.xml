<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="center_vertical">

    <!-- Split label (50M, 100M, …) -->
    <TextView
        android:id="@+id/tvSplitLabel"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:text="—" />

    <!-- Current run: time + speed -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSplitCurTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/primary_color"
            android:text="—" />

        <TextView
            android:id="@+id/tvSplitCurSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:text="" />
    </LinearLayout>

    <!-- Compare run: time + speed -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvSplitCmpTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="#A64CEB"
            android:text="—" />

        <TextView
            android:id="@+id/tvSplitCmpSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_tertiary"
            android:text="" />
    </LinearLayout>

    <!-- Delta -->
    <TextView
        android:id="@+id/tvSplitDelta"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:gravity="end"
        android:textColor="@color/drag_run_green"
        android:text="" />

</LinearLayout>
