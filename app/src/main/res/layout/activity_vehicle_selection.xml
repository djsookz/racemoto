<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fitsSystemWindows="true">

    <!-- Full Screen Content Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <!-- Vehicle Type Selection -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vehicle Type"
                android:textColor="@color/text_primary_light"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Car Option -->
            <LinearLayout
                android:id="@+id/carCard"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/vehicle_option_background"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="36sp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Car"
                    android:textColor="@color/text_primary_light"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Motorcycle Option -->
            <LinearLayout
                android:id="@+id/motorcycleCard"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/vehicle_option_background"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏍️"
                    android:textSize="36sp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Motorcycle"
                    android:textColor="@color/text_primary_light"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vehicle Brand Selection -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/brandInput"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Select Brand"
            android:textColorHint="@color/white"
            app:boxStrokeColor="@color/primary_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/primary_color"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/dark_surface"
            app:startIconDrawable="@drawable/ic_car"
            app:startIconTint="@color/primary_color">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/brandDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@null"
                android:popupBackground="@color/white"
                android:dropDownSelector="@color/primary_color"
                android:dropDownVerticalOffset="8dp"
                android:dropDownWidth="match_parent" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Vehicle Model Selection -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/modelInput"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:hint="Select Model"
            android:textColorHint="@color/white"
            app:boxStrokeColor="@color/primary_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/primary_color"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/dark_surface"
            app:startIconDrawable="@drawable/ic_settings"
            app:startIconTint="@color/primary_color">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/modelDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@null"
                android:popupBackground="@color/white"
                android:dropDownSelector="@color/primary_color"
                android:dropDownVerticalOffset="8dp"
                android:dropDownWidth="match_parent" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- READY Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReady"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="READY"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_color"
            app:cornerRadius="32dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>
</FrameLayout>

