<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/card_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drag_mode_dialog_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnMeasureAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drag_mode_all"
        android:textSize="16sp"
        android:padding="14dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="@color/primary_color"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn0to100"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drag_mode_0to100"
            android:textSize="14sp"
            android:padding="12dp"
            android:backgroundTint="@color/accent_green"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn0to200"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drag_mode_0to200"
            android:textSize="14sp"
            android:padding="12dp"
            android:backgroundTint="@color/accent_blue"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btn100to200"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drag_mode_100to200"
            android:textSize="14sp"
            android:padding="12dp"
            android:backgroundTint="@color/accent_orange"
            android:layout_marginEnd="4dp"/>

        <Button
            android:id="@+id/btn0to402"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/drag_mode_quarter"
            android:textSize="14sp"
            android:padding="12dp"
            android:backgroundTint="@color/accent_red"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drag_mode_note"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btnCancelMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/drag_mode_cancel"
        android:textSize="14sp"
        android:padding="12dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="@color/text_secondary"/>

</LinearLayout>