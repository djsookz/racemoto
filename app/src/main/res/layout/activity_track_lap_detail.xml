<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    android:fitsSystemWindows="true">

    <!-- Fixed main content като в MapActivity -->
    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

            <!-- Top Bar -->
            <RelativeLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#121212"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:elevation="8dp"
                android:fitsSystemWindows="true">

                <TextView
                    android:id="@+id/btnBack"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textColor="#FFFFFF"
                    android:drawableTint="@color/white"
                    android:drawableStart="@drawable/ic_arrow_back"
                    android:textSize="22sp"
                    android:padding="8dp"
                    android:contentDescription="Назад" />

                <!-- Previous Lap Button - Left Edge -->
                <TextView
                    android:id="@+id/btnPreviousLap"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:layout_marginStart="60dp"
                    android:gravity="center"
                    android:text="◀"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/track_prev_lap" />

                <TextView
                    android:id="@+id/tvLapTitle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_marginStart="120dp"
                    android:layout_marginEnd="120dp"
                    android:gravity="center"
                    android:text="@string/track_lap_label"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:ellipsize="end"
                    android:singleLine="true" />

                <!-- Next Lap Button - Right Edge -->
                <TextView
                    android:id="@+id/btnNextLap"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="60dp"
                    android:gravity="center"
                    android:text="▶"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/track_next_lap" />

            </RelativeLayout>

            <!-- Map Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="2dp">

                <org.osmdroid.views.MapView
                    android:id="@+id/mapRoute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

            </androidx.cardview.widget.CardView>



            <!-- Reader Values Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#3A3D40"
                android:paddingVertical="5dp"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="2dp">

                <TextView
                    android:id="@+id/tvReaderSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#FC7805"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginEnd="32dp" />

                <TextView
                    android:id="@+id/tvReaderAngle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text=""
                    android:textColor="#05FCE3"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginStart="32dp"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Tabs Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:backgroundTint="#3A3D40">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tabs"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="32dp"
                    android:background="#3A3D40"
                    app:tabIndicatorColor="#1976D2"
                    app:tabSelectedTextColor="#1976D2"
                    app:tabTextColor="@color/white"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabMinWidth="0dp"
                    app:tabMaxWidth="0dp" />

            </androidx.cardview.widget.CardView>

            <!-- Chart Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="2dp"
                android:backgroundTint="#3A3D40">

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="180dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

</FrameLayout>
