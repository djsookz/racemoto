<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="@color/dark_surface">

        <!-- Заглавие -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добави в гаража"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="32dp" />

        <!-- Избор на тип превозно средство -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Избери тип превозно средство"
            android:textSize="16sp"
            android:textColor="@color/white"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">

            <!-- Кола опция -->
            <LinearLayout
                android:id="@+id/carCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/vehicle_option_background"
                android:layout_marginEnd="8dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🚗"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Кола"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Мотоциклет опция -->
            <LinearLayout
                android:id="@+id/motorcycleCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/vehicle_option_background"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏍️"
                    android:textSize="32sp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мотоциклет"
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

        <!-- Избор на марка -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/brandInput"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:hint="Select Brand"
            android:textColorHint="@color/white"
            app:boxStrokeColor="@color/primary_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/primary_color"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/dark_surface"
            app:startIconDrawable="@drawable/ic_car"
            app:startIconTint="@color/primary_color">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/brandDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@null"
                android:popupBackground="@color/white"
                android:dropDownSelector="@color/primary_color"
                android:dropDownVerticalOffset="8dp"
                android:dropDownWidth="match_parent" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Избор на модел -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/modelInput"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:hint="Select Model"
            android:textColorHint="@color/white"
            app:boxStrokeColor="@color/primary_color"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="2dp"
            app:endIconTint="@color/primary_color"
            app:boxBackgroundMode="outline"
            app:boxBackgroundColor="@color/dark_surface"
            app:startIconDrawable="@drawable/ic_settings"
            app:startIconTint="@color/primary_color">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/modelDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:background="@null"
                android:popupBackground="@color/white"
                android:dropDownSelector="@color/primary_color"
                android:dropDownVerticalOffset="8dp"
                android:dropDownWidth="match_parent" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

</ScrollView>
