<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="75dp"
        android:background="@color/card_background"
        android:paddingHorizontal="5dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iconGarage"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_garage"
            app:tint="@android:color/white"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp" />

        <TextView
            android:id="@+id/titleGarage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/garage_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_toEndOf="@id/iconGarage"
            android:layout_marginStart="8dp"
            android:layout_centerVertical="true" />

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/btnAddProfile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:elevation="6dp"
            android:text="@string/garage_add_button"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/accent_color"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_add"
            app:iconTint="@android:color/white" />

    </RelativeLayout>

    <!-- Horizontal layout for landscape: Active Profile on left, Collection on right -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Left side: Active Profile Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardActiveProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/card_background"
            app:contentPadding="0dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:background="@color/card_background"
                android:padding="0dp">

                <FrameLayout
                    android:id="@+id/flProfileImageContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp"
                    android:layout_marginTop="0dp"
                    android:layout_marginBottom="0dp"
                    android:padding="0dp"
                    android:background="@drawable/profile_icon_background"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:clipToPadding="false"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/ivActiveProfileIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="fill"
                        android:src="@drawable/ic_car"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/garage_profile_image"
                        app:tint="@color/primary_color" />

                    <!-- Fade градиент в долната част -->
                    <View
                        android:id="@+id/vFadeOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/gradient_fade_bottom"
                        android:visibility="gone" />

                    <!-- Landscape: Profile name and type overlay in bottom left corner when image is shown -->
                    <LinearLayout
                        android:id="@+id/llLandscapeProfileInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/profile_info_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvActiveProfileNameOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/garage_my_profile"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white" />

                        <TextView
                            android:id="@+id/tvActiveProfileTypeOverlay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/garage_vehicle_car"
                            android:textSize="12sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.9"
                            android:layout_marginTop="2dp" />

                    </LinearLayout>

                </FrameLayout>

                <!-- Orange divider -->
                <View
                    android:id="@+id/vOrangeDivider"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@color/primary_color"
                    android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/llProfileTextContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvActiveProfileName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/garage_my_profile"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        />

                    <TextView
                        android:id="@+id/tvActiveProfileType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/garage_vehicle_car"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:alpha="0.85"
                        android:layout_marginTop="4dp" />
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Right side: My Collection -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:id="@+id/profilesHeaderLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:paddingHorizontal="10dp"
                android:gravity="center_vertical"
                android:background="@drawable/rounded_corners">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/garage_my_collection"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvProfileCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/5"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:background="@drawable/profile_count_background"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProfiles"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom navigation is handled by MainContainerActivity - removed from here -->

</androidx.constraintlayout.widget.ConstraintLayout>

