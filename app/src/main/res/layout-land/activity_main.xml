<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    tools:context=".MainActivity">

    <!-- Top: Map Section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2">

        <!-- MapView will be added programmatically based on selected provider -->
        <FrameLayout
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            
            <!-- OSMDroid MapView (default, will be removed if Mapbox is selected) -->
            <org.osmdroid.views.MapView
                android:id="@+id/mapView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
        
        <!-- Official ManeuverView (landscape: fixed width 300dp, top-left, smaller margin) -->
        <FrameLayout
            android:id="@+id/maneuverContainer"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/hud_maneuver_margin_start_landscape"
            android:layout_marginEnd="@dimen/hud_maneuver_margin_end_landscape"
            android:layout_marginTop="25dp"
            android:background="@drawable/bg_map_controls_pill"
            android:clipToOutline="true"
            android:outlineProvider="background"
            >

            <com.mapbox.navigation.ui.components.maneuver.view.MapboxManeuverView
                android:id="@+id/maneuverView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </FrameLayout>

        <!-- Legacy custom maneuver layout (OSMDroid/manual flow) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/maneuverViewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:cardBackgroundColor="#E6202123"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/ivManeuverIcon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_turn_straight"
                    app:tint="#FFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvManeuverDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="500 m"
                        android:textColor="#FF6020"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvManeuverPrimary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Continue"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:maxLines="2"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tvManeuverSecondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#A0A0A0"
                        android:textSize="13sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Map controls (top-right, landscape: higher margin) -->
        <LinearLayout
            android:id="@+id/mapControlsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="70dp"
            android:background="@drawable/bg_map_controls_pill"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="8dp"
            android:gravity="center_horizontal">

            <ImageButton
                android:id="@+id/btnOrientationToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_control_orientation"
                android:src="@drawable/ic_unlock"
                android:padding="6dp"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnCameraNorthMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/map_control_heading_mode"
                android:src="@drawable/ic_map_heading"
                android:padding="6dp"
                app:tint="#FFFFFF" />

            <!-- Navigation-only controls -->
            <ImageButton
                android:id="@+id/btnOverview"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Overview"
                android:src="@drawable/ic_route"
                android:padding="6dp"
                android:visibility="gone"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnRecenter"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Recenter"
                android:src="@drawable/ic_navigation"
                android:padding="6dp"
                android:visibility="gone"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- Car stats overlay (landscape: top-left, below maneuver) -->
        <LinearLayout
            android:id="@+id/carStatsOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="@dimen/hud_car_stats_margin_start_landscape"
            android:layout_marginTop="165dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_map_controls_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/distanceTextCarLandscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.00"
                    android:textColor="#FFFFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="km"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="36dp"
                android:layout_marginHorizontal="12dp"
                android:background="#3DFFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <Chronometer
                    android:id="@+id/chronometerCarLandscape"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="time"
                    android:textColor="#E0E0E0"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bottom HUD (landscape: horizontal layout - speed | angle | pills | buttons) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomHudRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingStart="0dp"
            android:paddingEnd="@dimen/hud_bottom_row_padding_end_landscape"
            android:paddingBottom="0dp"
            android:layout_marginStart="@dimen/hud_bottom_row_margin_start_landscape"
            android:layout_marginBottom="@dimen/hud_bottom_row_margin_bottom_landscape"
            android:clipToPadding="false">

            <!-- Speed overlay (fixed width in landscape) -->
            <LinearLayout
                android:id="@+id/speedOverlayContainer"
                android:layout_width="@dimen/hud_speed_width_landscape"
                android:layout_height="wrap_content"
                android:visibility="visible"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/speedTextCar"
                    android:layout_width="@dimen/hud_speed_width_landscape"
                    android:layout_height="wrap_content"
                    android:minWidth="@dimen/hud_speed_width_landscape"
                    android:gravity="center"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="12dp"
                    android:background="@drawable/bg_speed_circle"
                    android:text="0"
                    android:textColor="#FFFFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>
            </LinearLayout>

            <!-- Barrier: groups speed and angle together (angle can be GONE in car mode) -->
            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/speedAngleBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="end"
                app:constraint_referenced_ids="speedOverlayContainer,angleLandscapeContainer" />

            <!-- Angle block (landscape motorcycle) - fixed width, positioned between speed and trip progress -->
            <LinearLayout
                android:id="@+id/angleLandscapeContainer"
                android:layout_width="@dimen/hud_angle_block_width_landscape"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hud_angle_margin_start_landscape"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible"
                app:layout_constraintStart_toEndOf="@+id/speedOverlayContainer"
                app:layout_constraintBottom_toBottomOf="parent">

                <TextView
                    android:id="@+id/angleTextMotoLandscape"
                    android:layout_width="75dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="left"
                    android:gravity="center"
                    android:textAlignment="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:background="@drawable/bg_angle_pill"
                    android:text="0°"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"/>

                <com.example.clinometer.LinearGaugeView
                    android:id="@+id/linearGaugeViewLandscape"
                    android:layout_width="@dimen/hud_angle_gauge_width_landscape"
                    android:layout_height="16dp"
                    android:visibility="gone"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- Trip progress pills (landscape: constrained after barrier, before buttons) -->
            <!-- Barrier automatically handles GONE views - when angleLandscapeContainer is GONE, barrier is at speedOverlayContainer end -->
            <LinearLayout
                android:id="@+id/tripProgressContainer"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hud_trip_gap_landscape"
                android:background="@drawable/bg_map_controls_pill"
                android:gravity="center"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/hud_trip_padding_h_landscape"
                android:paddingVertical="@dimen/hud_trip_padding_v_landscape"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/carActionButtonsOverlay"
                app:layout_constraintStart_toEndOf="@+id/speedOverlayContainer"
                app:layout_constraintWidth_default="spread">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripEta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="@dimen/hud_trip_value_min_width_landscape"
                        android:singleLine="true"
                        android:text="--:--"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/hud_trip_value_text_size_landscape"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTripEtaLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="ETA"
                        android:textColor="#E0E0E0"
                        android:textSize="@dimen/hud_trip_label_text_size_landscape" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="@dimen/hud_trip_separator_margin_h_landscape"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="83dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripRemainingTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="@dimen/hud_trip_value_min_width_landscape"
                        android:singleLine="true"
                        android:text="--:--"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/hud_trip_value_text_size_landscape"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTripRemainingTimeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="time"
                        android:textColor="#E0E0E0"
                        android:textSize="@dimen/hud_trip_label_text_size_landscape" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="32dp"
                    android:layout_marginHorizontal="@dimen/hud_trip_separator_margin_h_landscape"
                    android:background="#33FFFFFF" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTripRemainingDistance"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:minWidth="@dimen/hud_trip_value_min_width_landscape"
                        android:singleLine="true"
                        android:text="--"
                        android:textColor="#FFFFFFFF"
                        android:textSize="@dimen/hud_trip_value_text_size_landscape"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTripRemainingDistanceLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="km"
                        android:textColor="#E0E0E0"
                        android:textSize="@dimen/hud_trip_label_text_size_landscape" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action buttons (landscape: right-aligned, to the right of pills) -->
            <LinearLayout
                android:id="@+id/carActionButtonsOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="visible"
                android:clipToPadding="false"
                android:clipChildren="false"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageButton
                    android:id="@+id/btnResetCarMap"
                    android:layout_width="@dimen/hud_action_btn_size_landscape"
                    android:layout_height="@dimen/hud_action_btn_size_landscape"
                    android:layout_marginEnd="@dimen/hud_action_btn_margin_end_landscape"
                    android:background="@drawable/bg_circle_button_reset"
                    android:src="@drawable/ic_reset_arrow_white"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/hud_action_btn_padding_landscape"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/reset_button"
                    android:stateListAnimator="@null"/>

                <ImageButton
                    android:id="@+id/btnZeroCarMap"
                    android:layout_width="@dimen/hud_action_btn_size_landscape"
                    android:layout_height="@dimen/hud_action_btn_size_landscape"
                    android:layout_marginEnd="@dimen/hud_action_btn_margin_end_landscape"
                    android:background="@drawable/bg_circle_button_zero"
                    android:src="@drawable/ic_zero_calibrate"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/hud_action_btn_padding_landscape"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/zero_button"
                    android:stateListAnimator="@null"
                    android:visibility="visible"/>

                <ImageButton
                    android:id="@+id/btnStopCarMap"
                    android:layout_width="@dimen/hud_action_btn_size_landscape"
                    android:layout_height="@dimen/hud_action_btn_size_landscape"
                    android:background="@drawable/bg_circle_button_stop"
                    android:src="@drawable/ic_stop_square_white"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/hud_action_btn_padding_landscape"
                    android:scaleType="centerInside"
                    android:contentDescription="@string/stop_button"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

            <!-- Portrait-specific elements (always GONE in landscape) -->
            <LinearLayout
                android:id="@+id/angleContainerMoto"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Portrait-specific elements (always GONE in landscape) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/dashboardContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

