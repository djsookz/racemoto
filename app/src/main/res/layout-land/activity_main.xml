<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117"
    tools:context=".MainActivity"
    android:fitsSystemWindows="true">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top-left: Timer + Distance -->
    <LinearLayout
        android:id="@+id/topLeftInfo"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:layout_gravity="top|start"
        android:layout_marginStart="15dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_rounded_translucent"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Time column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Време"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="5dp"/>

            <Chronometer
                android:id="@+id/chronometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD700"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- Distance column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Разстояние"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginBottom="5dp"/>

            <TextView
                android:id="@+id/distanceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 km"
                android:textSize="18sp"
                android:textColor="#00D4FF" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom-left: Speed + Angle overlay -->
    <LinearLayout
        android:id="@+id/bottomLeftInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/speedText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:shadowColor="#0099CC"
            android:shadowRadius="10"
            android:textColor="#00D4FF"
            android:text="0"
            android:textSize="40sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rounded_translucent"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/currentAngleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:text="0°"
            android:shadowColor="#0099CC"
            android:shadowRadius="10"
            android:textColor="#00D4FF"
            android:textSize="20sp"
            android:background="@drawable/bg_rounded_translucent" />
    </LinearLayout>

    <!-- Right: Vertical small buttons -->
    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_gravity="bottom|end"
        android:padding="8dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnReset"
            android:layout_width="100dp"
            android:layout_height="45dp"
            android:layout_marginEnd="8dp"
            android:text="@string/reset_button"
            android:textColor="#000"
            app:backgroundTint="#FFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:background="@drawable/rounded_button"/>

        <Button
            android:id="@+id/btnZero"
            android:layout_width="100dp"
            android:layout_height="45dp"
            android:layout_marginEnd="8dp"
            android:text="@string/zero_button"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:background="@drawable/rounded_button"/>

        <Button
            android:id="@+id/btnStop"
            android:layout_width="100dp"
            android:layout_height="45dp"
            android:text="@string/stop_button"
            android:textColor="#FFFFFF"
            app:backgroundTint="#E53E3E"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            android:stateListAnimator="@null"
            android:background="@drawable/rounded_button"/>
    </LinearLayout>

    <!-- Hidden/aux views required by MainActivity (kept but hidden) -->
    <com.example.clinometer.GaugeView
        android:id="@+id/gaugeView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"/>

    

    <LinearLayout
        android:id="@+id/hiddenMetrics"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvZeroTo100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvZeroTo200"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvHundredTo200"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/maxLeftText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/maxRightText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"/>
    </LinearLayout>

    <TextView
        android:id="@+id/maxSpeedText"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"/>

    <ImageButton
        android:id="@+id/btnOrientationToggle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_translucent"
        android:contentDescription="Orientation toggle"
        android:src="@drawable/ic_unlock"
        app:tint="#FFFFFF"
        android:elevation="10dp"
        android:visibility="visible"/>

</FrameLayout>

 