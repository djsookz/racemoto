<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Цвят за фон на навигацията -->
    <color name="nav_dark_background">#E6202123</color>

    <!-- Mapbox Maneuver View Style -->
    <style name="MapboxCustomManeuverStyle" parent="MapboxStyleManeuverView">
        <item name="maneuverViewBackgroundColor">@android:color/transparent</item>
        <item name="subManeuverViewBackgroundColor">@android:color/transparent</item>
        <item name="upcomingManeuverViewBackgroundColor">@android:color/transparent</item>
    </style>

    <style name="RevixManeuverPrimaryText" parent="MapboxStylePrimaryManeuver">
        <item name="android:textColor">#FF6020</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">2</item>
        <item name="android:singleLine">false</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="RevixManeuverPrimaryTextLand" parent="RevixManeuverPrimaryText">
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RevixManeuverStepDistance" parent="MapboxStyleStepDistance">
        <item name="android:textColor">#FF6020</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="RevixManeuverStepDistanceLand" parent="RevixManeuverStepDistance">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Стил за бели текстове в навигацията -->
    <style name="ManeuverTextAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ManeuverDistanceAppearance" parent="TextAppearance.AppCompat">
        <item name="android:textColor">#FF6020</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Стил за Trip Progress -->
    <style name="TripProgressCardStyle">
        <item name="android:background">@drawable/bg_map_controls_pill</item>
        <item name="android:backgroundTint">@color/nav_dark_background</item>
    </style>

    <!-- Останалите стилове на апликацията -->
    <style name="AccessibleText">
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:importantForAccessibility">yes</item>
    </style>
    <style name="DeleteButtonStyle">
        <item name="android:textColor">@color/white</item>
        <item name="android:backgroundTint">@color/red</item>
    </style>
    <style name="ModernButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:elevation">4dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
    <style name="CustomAlertDialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_modal_card</item>
        <item name="colorPrimary">@color/primary_color</item>
        <item name="colorAccent">@color/primary_color</item>
        <item name="colorSurface">@color/card_background</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorAlertDialogListItem">@color/white</item>
        <item name="textColorAlertDialogListItem">@color/white</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.App.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.App.DialogButton.Negative</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.App.DialogButton.Positive</item>
    </style>

    <style name="Widget.App.DialogButton.Positive" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary_color</item>
    </style>

    <style name="Widget.App.DialogButton.Negative" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="Theme.DragMe.Splash" parent="Theme.DragMe">
        <!-- Android 12+ system splash: custom icon so launch icon is not shown tiny in a white mask -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_revix</item>
        <item name="android:windowSplashScreenBackground">@color/dark_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TextAppearance.GarageProfileTab" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">9sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.DragCompareProfileTab" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>